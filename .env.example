# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on inside its process/container
PORT=3200
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve Swagger UI at /docs and the OpenAPI document at /docs/openapi.json
SWAGGER_ENABLED=true
# Comma-separated allowed CORS origins (empty = CORS disabled)
CORS_ORIGINS=

# --- PostgreSQL --------------------------------------------------------------
# Matches the `postgres` service of docker-compose.yml (host port POSTGRES_HOST_PORT)
DATABASE_URL=postgresql://erp:erp@localhost:5460/inventory_erp?schema=public

# --- Redis (BullMQ) ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=

# --- JWT ---------------------------------------------------------------------
# Use long random values, e.g. `openssl rand -base64 48`. Min. 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
# Access token lifetime in seconds (15 min)
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
# Refresh token lifetime in seconds (7 days)
JWT_REFRESH_TTL=604800

# --- Seed (npm run db:seed) --------------------------------------------------
# Password given to the demo users admin@ / manager@ / operator@inventory.local
SEED_USER_PASSWORD=ChangeMe-Demo-123

# --- docker compose host ports ----------------------------------------------
API_HOST_PORT=3200
POSTGRES_HOST_PORT=5460
REDIS_HOST_PORT=6390
